&MOM_input_nml
    output_directory = './'
    restart_input_dir = './'
    restart_output_dir = './'
    parameter_filename = 'MOM_input', 'MOM_override'
/

&generic_tracer_nml
    do_generic_tracer=.true.
    do_generic_BLING=.true.
    force_update_fluxes=.false. !This has to be set for THERMO_SPANS_COUPLING to work
/

&generic_bling_nml
    co2_calc='mocsy'
    do_14c=.false.
    do_carbon=.true.
    do_carbon_pre=.false.
    do_po4_pre=.false.
    bury_caco3=.true.
    bury_pop=.true.
/

&fms_nml
    clock_grain = 'ROUTINE'
    clock_flags = 'NONE'
    domains_stack_size = 5000000
    stack_size = 0
/

&diag_manager_nml
    flush_nc_files = .true.
    max_axes = 400
    max_files = 200
    max_num_axis_sets = 200
/

&mpp_io_nml
    cf_compliance = .true.
/

&fms2_io_nml
    netcdf_default_format = "netcdf4"
    deflate_level = 4
    shuffle = .true.
/
